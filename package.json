{
  "name": "travelhub-gulf",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/types/database.generated.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:new": "supabase migration new"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@upstash/ratelimit": "^2.0.3",
    "@upstash/redis": "^1.34.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.454.0",
    "motion": "^11.11.0",
    "next": "^16.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^17.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.8.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "^16.3.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}